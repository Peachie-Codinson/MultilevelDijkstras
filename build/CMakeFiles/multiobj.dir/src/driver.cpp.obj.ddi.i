        auto topo = topologicalSort();



        for (size_t i = 0; i + 1 < topo.size(); ++i) {
            auto u = getVertex(topo[i]);
            auto v = getVertex(topo[i + 1]);
            bool edge_found = false;

            for (const auto &e : u->out_edges) {
                if (e->to == v) {
                    edge_found = true;
                    break;
