template <typename ElementType, typename CostType> struct ElementWithCost {
    ElementType element;
    CostType cost;
    size_t eid;

    bool operator==(const ElementWithCost &other) const {
        return eid == other.eid;
    }

    friend std::ostream &operator<<(std::ostream &os,
