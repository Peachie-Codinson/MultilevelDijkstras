    void
    removeElementsFromQueue(std::queue<size_t> &Q,
                            const std::unordered_set<size_t> &to_remove) const {
        std::queue<size_t> newQueue;

        while (!Q.empty()) {
            size_t element = Q.front();
            Q.pop();


            if (to_remove.find(element) == to_remove.end()) {
                newQueue.push(element);
